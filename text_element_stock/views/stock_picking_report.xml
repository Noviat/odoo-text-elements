<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
        <!-- Set before the layout is called, so that the layout sees it. -->
        <xpath expr="//t[@t-call='web.external_layout']" position="before">
            <t
                t-set="text_element_record"
                t-value="o.with_context(lang=o._get_report_lang())"
            />
            <t t-set="use_text_elements" t-value="True" />
        </xpath>
        <div id="informations" position="after">
            <t
                t-call="text_element_base.text_element_layout"
                position.f="before_line"
            />
        </div>
        <!-- After the move tables, whichever of the two is printed. -->
        <xpath expr="//t[@t-set='backorders']" position="before">
            <div class="mt-3" />
            <t t-call="text_element_base.text_element_layout" position.f="after_line" />
        </xpath>
    </template>
</odoo>
