<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="text_element_page" string="Text Elements">
                    <button
                        string="Add Text Element"
                        name="action_add_element_wizard"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Edit Text Element"
                        name="action_edit_element_wizard"
                        type="object"
                        class="btn-primary"
                    />
                    <group>
                        <group>
                            <field name="report_lang" />
                        </group>
                    </group>
                    <separator string="Text Elements" />
                    <field
                        name="text_element_ids"
                        nolabel="1"
                        options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}"
                        readonly="1"
                        force_save="1"
                    >
                        <list>
                            <field name="sequence" />
                            <field name="name" />
                            <field name="position" />
                            <field name="page_break_before" />
                            <field name="page_break_after" />
                            <field name="company_id" groups="base.group_system" />
                            <field
                                name="user_id"
                                groups="sales_team.group_sale_manager"
                            />
                            <button
                                name="action_remove"
                                string=" "
                                icon="fa-trash"
                                type="object"
                                context="{'active_id': parent.id, 'active_model': 'sale.order'}"
                            />
                        </list>
                    </field>
                    <separator string="Custom Text Elements" />
                    <field
                        name="text_element_custom_ids"
                        nolabel="1"
                        options="{'no_create': True, 'no_create_edit': True, 'no_edit': True}"
                        context="{'default_res_id': id, 'default_res_model': 'sale.order', 'form_view_ref': 'text_element_base.text_element_custom_simplified_form_view'}"
                        force_save="1"
                    />
                </page>
            </notebook>
        </field>
    </record>
</odoo>
