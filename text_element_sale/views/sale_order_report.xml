<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_saleorder_document"
        inherit_id="sale.report_saleorder_document"
    >
        <!-- doc is set with its language before the layout is called. -->
        <xpath expr="//t[@t-set='doc']" position="after">
            <t t-set="text_element_record" t-value="doc" />
            <t t-set="use_text_elements" t-value="True" />
        </xpath>
        <xpath expr="//t[@t-set='display_discount']" position="after">
            <t
                t-call="text_element_base.text_element_layout"
                position.f="before_line"
            />
        </xpath>
        <div name="so_total_summary" position="after">
            <div class="mt-3" />
            <t t-call="text_element_base.text_element_layout" position.f="after_line" />
        </div>
    </template>
</odoo>
