<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="text_element_form_view" model="ir.ui.view">
        <field name="name">text.element.form</field>
        <field name="model">text.element</field>
        <field name="inherit_id" ref="text_element_accounting.text_element_form_view" />
        <field name="arch" type="xml">
            <field name="only_shown_in_proforma" position="attributes">
                <attribute
                    name="invisible"
                >res_model not in ['sale.order','account.move']</attribute>
            </field>
        </field>
    </record>
    <record id="text_element_custom_simplified_form_view" model="ir.ui.view">
        <field name="name">text.element.custom.simplified.form</field>
        <field name="model">text.element.custom</field>
        <field
            name="inherit_id"
            ref="text_element_accounting.text_element_custom_simplified_form_view"
        />
        <field name="arch" type="xml">
            <field name="only_shown_in_proforma" position="attributes">
                <attribute
                    name="invisible"
                >res_model not in ['sale.order','account.move']</attribute>
            </field>
        </field>
    </record>
    <record id="text_element_custom_tree_view" model="ir.ui.view">
        <field name="name">text.element.custom.tree</field>
        <field name="model">text.element.custom</field>
        <field
            name="inherit_id"
            ref="text_element_accounting.text_element_custom_tree_view"
        />
        <field name="arch" type="xml">
            <field name="only_shown_in_proforma" position="attributes">
                <attribute
                    name="invisible"
                >res_model not in ['sale.order','account.move']</attribute>
            </field>
        </field>
    </record>
</odoo>
