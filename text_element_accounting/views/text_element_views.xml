<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="text_element_form_view" model="ir.ui.view">
        <field name="name">text.element.form</field>
        <field name="model">text.element</field>
        <field name="inherit_id" ref="text_element_base.text_element_form_view" />
        <field name="arch" type="xml">
            <field name="res_model" position="after">
                <field name="move_type" invisible="res_model != 'account.move'" />
                <field
                    name="only_shown_in_proforma"
                    invisible="res_model != 'account.move'"
                />
            </field>
        </field>
    </record>
    <record id="text_element_custom_simplified_form_view" model="ir.ui.view">
        <field name="name">text.element.custom.simplified.form</field>
        <field name="model">text.element.custom</field>
        <field
            name="inherit_id"
            ref="text_element_base.text_element_custom_simplified_form_view"
        />
        <field name="arch" type="xml">
            <field name="res_model" position="after">
                <field name="move_type" invisible="res_model != 'account.move'" />
                <field
                    name="only_shown_in_proforma"
                    invisible="res_model != 'account.move'"
                />
            </field>
        </field>
    </record>
    <record id="text_element_custom_tree_view" model="ir.ui.view">
        <field name="name">text.element.custom.list</field>
        <field name="model">text.element.custom</field>
        <field
            name="inherit_id"
            ref="text_element_base.text_element_custom_tree_view"
        />
        <field name="arch" type="xml">
            <field name="lang" position="after">
                <field
                    name="move_type"
                    invisible="res_model != 'account.move'"
                    optional="hide"
                />
                <field
                    name="only_shown_in_proforma"
                    invisible="res_model != 'account.move'"
                    optional="hide"
                />
            </field>
        </field>
    </record>
</odoo>
