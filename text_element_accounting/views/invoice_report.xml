<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-set='o']" position="after">
            <t t-set="text_element_record" t-value="o" />
            <t t-set="use_text_elements" t-value="True" />
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']" position="before">
            <t
                t-call="text_element_base.text_element_layout"
                position.f="before_line"
            />
        </xpath>
        <div id="right-elements" position="after">
            <!-- The totals float on the right: start below them. -->
            <div class="mt-3" style="clear: both" />
            <t t-call="text_element_base.text_element_layout" position.f="after_line" />
        </div>
    </template>
</odoo>
