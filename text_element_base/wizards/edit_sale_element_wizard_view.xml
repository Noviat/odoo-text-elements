<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="edit_text_element_wizard_form_view" model="ir.ui.view">
        <field name="name">edit.text.element.wizard.form</field>
        <field name="model">edit.text.element.wizard</field>
        <field name="arch" type="xml">
            <form string="Edit Text Element">
                <sheet>
                    <group>
                        <field name="res_id" invisible="1" />
                        <field name="res_model" invisible="1" />
                        <field name="text_element_domain" invisible="1" />
                        <field name="text_element_custom_domain" invisible="1" />
                        <field
                            name="text_element_id"
                            invisible="text_element_custom_id != False"
                            options="{'no_create_edit': True, 'no_create': True,'no_edit': True}"
                            domain="text_element_domain"
                        />
                        <field
                            name="text_element_custom_id"
                            invisible="text_element_custom_id != False"
                            options="{'no_create_edit': True, 'no_create': True,'no_edit': True}"
                            domain="text_element_custom_domain"
                        />
                    </group>
                    <group>
                        <group>
                            <field
                                name="name"
                                invisible="text_element_custom_id == False and text_element_id == False"
                            />
                            <field
                                name="sequence"
                                invisible="text_element_custom_id == False and text_element_id == False"
                            />
                        </group>
                        <group>
                            <field
                                name="position"
                                invisible="text_element_custom_id == False and text_element_id == False"
                            />
                            <field
                                name="page_break_before"
                                invisible="text_element_custom_id == False and text_element_id == False"
                            />
                            <field
                                name="page_break_after"
                                invisible="text_element_custom_id == False and text_element_id == False"
                            />
                        </group>
                    </group>
                    <notebook
                        invisible="text_element_custom_id == False and text_element_id == False"
                    >
                        <page string="Content" name="content">
                            <field
                                name="content"
                                nolabel="1"
                                options="{'style-inline': true, 'codeview': true}"
                            />
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button
                        string="Edit and Close"
                        name="action_edit_and_close"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Edit and Continue"
                        name="action_edit_and_continue"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        special="cancel"
                        data-hotkey="z"
                        string="Close"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
