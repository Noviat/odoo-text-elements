<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="add_text_element_wizard_form_view" model="ir.ui.view">
        <field name="name">add.text.element.wizard.form</field>
        <field name="model">add.text.element.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Text Element">
                <sheet>
                    <group>
                        <field name="lang" invisible="1" />
                        <field name="res_id" invisible="1" />
                        <field name="res_model" invisible="1" />
                        <field name="text_element_domain" invisible="1" />
                        <field
                            name="text_element_id"
                            options="{'no_create_edit': True, 'no_create': True,'no_edit': True}"
                            domain="text_element_domain"
                        />
                        <field name="is_edit" />
                    </group>
                    <group>
                        <group>
                            <field
                                name="name"
                                attrs="{'invisible':[('is_edit','!=',True)]}"
                            />
                            <field
                                name="sequence"
                                attrs="{'invisible':[('is_edit','!=',True)]}"
                            />
                        </group>
                        <group>
                            <field
                                name="position"
                                attrs="{'invisible':[('is_edit','!=',True)]}"
                            />
                            <field
                                name="page_break_before"
                                attrs="{'invisible':[('is_edit','!=',True)]}"
                            />
                            <field
                                name="page_break_after"
                                attrs="{'invisible':[('is_edit','!=',True)]}"
                            />
                        </group>
                    </group>
                    <notebook attrs="{'invisible':[('is_edit','!=',True)]}">
                        <page string="Content">
                            <field
                                name="content"
                                nolabel="1"
                                options="{'style-inline': true, 'codeview': true}"
                            />
                        </page>
                    </notebook>
                    <group>

                    </group>
                </sheet>
                <footer>
                    <button
                        string="Add and Close"
                        name="action_add_and_close"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Add and Continue"
                        name="action_add"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        special="cancel"
                        data-hotkey="z"
                        string="Close"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
