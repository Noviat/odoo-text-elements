<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="text_element_form_view" model="ir.ui.view">
        <field name="name">text.element.form</field>
        <field name="model">text.element</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="position" />
                            <field name="model" invisible="1" />
                            <field
                                name="model_id"
                                placeholder="e.g. Contact"
                                options="{'no_create': True}"
                            />
                            <field
                                name="filter_domain"
                                widget="domain"
                                groups="!base.group_no_one"
                                options="{'model': 'model', 'in_dialog': False, 'foldable': True}"
                                invisible="not model_id"
                            />
                            <field
                                name="filter_domain"
                                widget="domain"
                                groups="base.group_no_one"
                                options="{'model': 'model', 'in_dialog': True}"
                                invisible="not model_id"
                            />
                        </group>
                        <group>
                            <field name="page_break_before" />
                            <field name="page_break_after" />
                            <field name="default" />
                            <field name="context_params" />
                        </group>
                    </group>
                    <notebook>
                        <page name="content_page" string="Content">
                            <field
                                name="content"
                                nolabel="1"
                                widget="html"
                                options="{'style-inline': true, 'codeview': true}"
                            />
                        </page>
                        <page
                            name="placeholder_generator"
                            string="Dynamic placerholder generator"
                            invisible="not model_id"
                        >
                            <group>
                                <field
                                    name="field_placeholder_generator"
                                    widget="field_selector"
                                    options="{'model': 'model'}"
                                />
                                <field
                                    name="field_placeholder_generator_name"
                                    invisible="not field_placeholder_generator"
                                />
                            </group>
                        </page>
                        <page name="other_informations" string="Others informations">
                            <group>
                                <field
                                    name="user_id"
                                    widget="many2one_avatar"
                                    invisible="1"
                                />
                                <field name="sequence" />
                                <field
                                    name="company_id"
                                    groups="base.group_multi_company"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="text_element_list_view" model="ir.ui.view">
        <field name="name">text.element.list</field>
        <field name="model">text.element</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="model" column_invisible="True" />
                <field name="active" column_invisible="True" />
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="position" />
                <field name="page_break_before" optional="show" />
                <field name="page_break_after" optional="show" />
                <field name="default" optional="show" />
                <field name="model_id" readonly="1" optional="hide" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="hide"
                />
                <field
                    name="filter_domain"
                    widget="domain"
                    options="{'model': 'model', 'in_dialog': False, 'foldable': True}"
                    readonly="1"
                    optional="hide"
                />
                <field
                    name="user_id"
                    widget="many2one_avatar"
                    optional="show"
                    column_invisible="1"
                />
            </list>
        </field>
    </record>

    <record id="text_element_search_view" model="ir.ui.view">
        <field name="name">text.element.search</field>
        <field name="model">text.element</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="content" />
                <field name="model_id" />
                <separator />
                <filter
                    name="before"
                    string="Before the document"
                    domain="[('position', '=', 'before')]"
                />
                <filter
                    name="before_line"
                    string="Before Lines (if applicable)"
                    domain="[('position', '=', 'before_line')]"
                />
                <filter
                    name="after_line"
                    string="After Lines (if applicable)"
                    domain="[('position', '=', 'after_line')]"
                />
                <filter
                    name="after"
                    string="After the document"
                    domain="[('position', '=', 'after')]"
                />
                <separator />
                <filter
                    name="default"
                    string="Default"
                    domain="[('default', '=', True)]"
                />
                <separator />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group>
                    <filter
                        name="group_manager"
                        string="Applies to"
                        domain="[]"
                        context="{'group_by':'model_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="text_element_simplified_form_view" model="ir.ui.view">
        <field name="name">text.element.simplified.form</field>
        <field name="model">text.element</field>
        <field name="inherit_id" ref="text_element_base.text_element_form_view" />
        <field name="mode">primary</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <field name="model_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="text_element_simplified_list_view" model="ir.ui.view">
        <field name="name">text.element.simplified.list</field>
        <field name="model">text.element</field>
        <field name="inherit_id" ref="text_element_base.text_element_list_view" />
        <field name="mode">primary</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <field name="model_id" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="user_id" position="after">
                <button
                    name="action_add_text_element_to_custom"
                    title="Add text element to custom elements"
                    icon="fa-plus"
                    type="object"
                    context="{'active_id': parent.id, 'active_model': parent._name}"
                />
                <button
                    name="action_remove"
                    title="Remove text element"
                    icon="fa-trash"
                    type="object"
                    context="{'active_id': parent.id, 'active_model': parent._name}"
                />
            </field>
        </field>
    </record>

    <record id="text_element_action" model="ir.actions.act_window">
        <field name="name">Text Elements</field>
        <field name="res_model">text.element</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="text_element_menu"
        action="text_element_action"
        name="Text Elements"
        parent="text_element_base.text_element_menu_category"
    />
</odoo>
