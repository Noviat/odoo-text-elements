<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="text_element_custom_form_view" model="ir.ui.view">
        <field name="name">text.element.custom.form</field>
        <field name="model">text.element.custom</field>
        <field name="inherit_id" ref="text_element_base.text_element_form_view" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="model_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="model_id" position="after">
                <field name="res_id" readonly="1" />
            </field>
        </field>
    </record>

    <record id="text_element_custom_tree_view" model="ir.ui.view">
        <field name="name">text.element.custom.tree</field>
        <field name="model">text.element.custom</field>
        <field name="inherit_id" ref="text_element_base.text_element_tree_view" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="model_id" position="after">
                <field name="res_id" />
            </field>
        </field>
    </record>

    <record id="text_element_custom_simplified_form_view" model="ir.ui.view">
        <field name="name">text.element.custom.simplified.form</field>
        <field name="model">text.element.custom</field>
        <field
            name="inherit_id"
            ref="text_element_base.text_element_custom_form_view"
        />
        <field name="mode">primary</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <field name="model_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="res_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="text_element_custom_simplified_tree_view" model="ir.ui.view">
        <field name="name">text.element.custom.simplified.tree</field>
        <field name="model">text.element.custom</field>
        <field
            name="inherit_id"
            ref="text_element_base.text_element_custom_tree_view"
        />
        <field name="mode">primary</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <field name="model_id" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="res_id" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="text_element_custom_action" model="ir.actions.act_window">
        <field name="name">Custom Text Elements</field>
        <field name="res_model">text.element.custom</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="text_element_custom_menu"
        action="text_element_custom_action"
        name="Custom Text Elements"
        parent="text_element_base.text_element_menu_category"
    />
</odoo>
